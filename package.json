{
  "name": "rn-habitude",
  "main": "expo-router/entry",
  "version": "0.3.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:widget": "HABITUDE_WIDGET=1 expo run:ios",
    "prebuild:widget": "HABITUDE_WIDGET=1 expo prebuild --platform ios --clean",
    "postinstall": "lefthook install",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 TZ=America/Sao_Paulo jest",
    "test:watch": "bun run test --watch",
    "test:ci": "bun run test --coverage --ci"
  },
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "expo": "^57.0.4",
    "expo-application": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-widgets": "~57.0.3",
    "pressto": "^0.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-ease": "^0.7.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "~29.5",
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29",
    "jest-expo": "57.0.2",
    "lefthook": "2.1.10",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "patchedDependencies": {
    "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch"
  }
}
