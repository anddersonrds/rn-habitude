{
  "expo": {
    "name": "habitude",
    "slug": "rn-habitude",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitude",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.anddersonrds.habitude",
      "supportsTablet": false,
      "icon": "./assets/app-icon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "./plugins/withoutPushEntitlement",
      "expo-notifications",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
