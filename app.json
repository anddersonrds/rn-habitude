{
  "expo": {
    "name": "habitude",
    "slug": "rn-habitude",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitude",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.anddersonrds.habitude",
      "supportsTablet": false,
      "icon": "./assets/app-icon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.anddersonrds.habitude",
      "versionCode": 1,
      /* The habit database is a local SQLite file with no account behind it.
      Android's automatic backup would restore it onto another device through a
      path no code expects, so it is off. */
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      /* Only the one nothing else adds. `POST_NOTIFICATIONS` is left to the
      `expo-notifications` plugin, and the three Expo declares by default -
      `INTERNET` and the two external-storage reads - arrive without being
      listed here. Declaring a permission twice is how the list drifts. */
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "./plugins/withoutPushEntitlement",
      "expo-notifications",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
