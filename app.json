{
  "expo": {
    "name": "habitude",
    "slug": "rn-habitude",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitude",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.anddersonrds.habitude",
      "supportsTablet": false,
      "icon": "./assets/app-icon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.anddersonrds.habitude",
      "versionCode": 1,
      /* Off: a restore would put the local SQLite file on another device. */
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      /* The only one no module declares. `POST_NOTIFICATIONS` arrives from
      `expo-notifications`' own manifest, merged at build time. */
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          /* The id `HABIT_REMINDER_CHANNEL` carries. The icon is white on
          transparent because Android draws it from the alpha channel alone. */
          "defaultChannel": "habit-reminders",
          "icon": "./assets/images/notification-icon.png",
          "color": "#32ADE6"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
